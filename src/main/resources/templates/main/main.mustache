<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modern Call Center Dashboard</title>
    <style>
        :root {
            --bg-color: #f0f2f5;
            --sidebar-bg: #ffffff;
            --card-bg: #ffffff;
            --primary-blue: #3b82f6;
            --primary-light: #eff6ff;
            --text-dark: #1e293b;
            --text-gray: #64748b;
            --border-color: #e2e8f0;
            --danger-red: #ef4444;
            --success-green: #10b981;
            --warning-orange: #f59e0b;
            --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
            --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Pretendard', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-dark);
            height: 100vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        /* --- Header (Call Control Bar) --- */
        header {
            background: var(--card-bg);
            height: 70px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 24px;
            border-bottom: 1px solid var(--border-color);
            box-shadow: var(--shadow-sm);
            z-index: 10;
        }

        .header-left {
            display: flex;
            gap: 20px;
            align-items: center;
            font-weight: 700;
            font-size: 1.2rem;
            color: var(--primary-blue);
        }

        .call-timer {
            background-color: var(--danger-red);
            color: white;
            padding: 8px 16px;
            border-radius: 20px;
            font-weight: 700;
            font-family: monospace;
            font-size: 1.2rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .call-controls {
            display: flex;
            gap: 12px;
        }

        .btn-control {
            border: 1px solid var(--border-color);
            background: white;
            padding: 8px 16px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 0.9rem;
            font-weight: 600;
            color: var(--text-dark);
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .btn-control:hover {
            background-color: var(--primary-light);
            color: var(--primary-blue);
            border-color: var(--primary-blue);
        }

        .btn-control.active {
            background-color: var(--primary-blue);
            color: white;
        }

        /* --- Main Layout --- */
        .container {
            display: flex;
            flex: 1;
            height: calc(100vh - 70px);
        }

        /* --- Sidebar (Navigation & Personal Stats) --- */
        aside {
            width: 260px;
            background: var(--sidebar-bg);
            border-right: 1px solid var(--border-color);
            display: flex;
            flex-direction: column;
            padding: 20px;
            overflow-y: auto;
        }

        .nav-menu {
            list-style: none;
            margin-bottom: 30px;
        }

        .nav-item {
            padding: 12px;
            margin-bottom: 4px;
            border-radius: 8px;
            cursor: pointer;
            color: var(--text-gray);
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .nav-item.active {
            background-color: var(--primary-light);
            color: var(--primary-blue);
            font-weight: 600;
        }

        .stat-card {
            background: var(--bg-color);
            padding: 16px;
            border-radius: 12px;
            margin-bottom: 16px;
        }

        .stat-title {
            font-size: 0.85rem;
            color: var(--text-gray);
            margin-bottom: 8px;
        }

        .stat-value {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--primary-blue);
        }

        .stat-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 8px;
            font-size: 0.9rem;
        }

        /* --- Main Content Area --- */
        main {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        /* --- Main Tab Bar --- */
        .main-tab-bar {
            display: flex;
            background: #e5e7eb;
            padding: 8px 16px 0 16px;
            gap: 4px;
            border-bottom: 1px solid var(--border-color);
        }

        .main-tab {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 16px;
            background: #d1d5db;
            border: 1px solid var(--border-color);
            border-bottom: none;
            border-radius: 8px 8px 0 0;
            cursor: pointer;
            font-size: 0.9rem;
            font-weight: 600;
            color: var(--text-gray);
            transition: all 0.2s;
        }

        .main-tab:hover {
            background: #f3f4f6;
        }

        .main-tab.active {
            background: var(--card-bg);
            color: var(--text-dark);
            border-bottom: 1px solid var(--card-bg);
            margin-bottom: -1px;
        }

        .main-tab .tab-close {
            width: 18px;
            height: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 4px;
            font-size: 14px;
            color: var(--text-gray);
            transition: all 0.2s;
        }

        .main-tab .tab-close:hover {
            background: var(--danger-red);
            color: white;
        }

        .main-tab.churn-tab {
            background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%);
            border-color: #fecaca;
            color: var(--danger-red);
        }

        .main-tab.churn-tab.active {
            background: linear-gradient(135deg, #fef2f2 0%, #fff 100%);
        }

        .main-tab.churn-tab .tab-icon {
            animation: pulse 1.5s infinite;
        }

        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }

        /* --- Tab Content Area --- */
        .main-content-wrapper {
            flex: 1;
            padding: 24px;
            overflow-y: auto;
        }

        .tab-content {
            display: none;
            height: 100%;
        }

        .tab-content.active {
            display: flex;
            gap: 24px;
            animation: fadeIn 0.3s ease;
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        /* Left Column of Main (Customer Info + Call Log) */
        .main-col-left {
            flex: 2;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        /* Right Column of Main (History / Script) */
        .main-col-right {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        /* --- Cards --- */
        .card {
            background: var(--card-bg);
            border-radius: 16px;
            padding: 24px;
            box-shadow: var(--shadow-md);
            border: 1px solid var(--border-color);
        }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 1px solid var(--border-color);
        }

        .card-title {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--text-dark);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* --- Forms --- */
        .form-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
            margin-bottom: 16px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .form-group.full-width {
            grid-column: span 3;
        }

        label {
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--text-gray);
        }

        input[type="text"], select, textarea {
            padding: 10px 12px;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            font-size: 0.95rem;
            outline: none;
            transition: border-color 0.2s;
            background-color: #f9fafb;
        }

        input:focus, select:focus, textarea:focus {
            border-color: var(--primary-blue);
            background-color: white;
        }

        textarea {
            resize: vertical;
            min-height: 80px;
        }

        .checkbox-group {
            display: flex;
            gap: 12px;
            align-items: center;
            padding: 10px 0;
        }

        .checkbox-item {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 0.9rem;
            color: var(--text-dark);
        }

        /* --- Buttons --- */
        .btn-group {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-top: 10px;
        }

        .btn {
            padding: 10px 20px;
            border-radius: 8px;
            border: none;
            font-weight: 600;
            cursor: pointer;
            transition: opacity 0.2s;
        }

        .btn-primary {
            background-color: var(--primary-blue);
            color: white;
        }

        .btn-secondary {
            background-color: var(--text-dark);
            color: white;
        }

        .btn-outline {
            background-color: white;
            border: 1px solid var(--border-color);
            color: var(--text-dark);
        }

        /* --- History Table --- */
        .history-table {
            width: 100%;
            border-collapse: collapse;
        }

        .history-table th {
            text-align: left;
            padding: 12px;
            font-size: 0.85rem;
            color: var(--text-gray);
            border-bottom: 1px solid var(--border-color);
        }

        .history-table td {
            padding: 12px;
            font-size: 0.9rem;
            border-bottom: 1px solid var(--bg-color);
        }

        .badge {
            padding: 4px 8px;
            border-radius: 12px;
            font-size: 0.75rem;
            font-weight: 600;
        }
        .badge-blue { background: var(--primary-light); color: var(--primary-blue); }
        .badge-gray { background: #f1f5f9; color: var(--text-gray); }
        .badge-red { background: #fef2f2; color: var(--danger-red); }
        .badge-green { background: #f0fdf4; color: var(--success-green); }
        .badge-orange { background: #fffbeb; color: var(--warning-orange); }

        /* --- Tabs (Inside Card) --- */
        .tabs {
            display: flex;
            gap: 4px;
            margin-bottom: 16px;
            border-bottom: 1px solid var(--border-color);
        }

        .tab {
            padding: 8px 16px;
            cursor: pointer;
            font-size: 0.9rem;
            font-weight: 600;
            color: var(--text-gray);
            border-bottom: 2px solid transparent;
        }

        .tab.active {
            color: var(--primary-blue);
            border-bottom-color: var(--primary-blue);
        }

        /* --- Customer Detail Panel --- */
        .customer-detail {
            display: none;
            margin-top: 20px;
            padding: 20px;
            background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
            border-radius: 12px;
            border: 1px solid var(--border-color);
        }

        .customer-detail.show {
            display: block;
            animation: slideDown 0.3s ease;
        }

        @keyframes slideDown {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .customer-detail-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 16px;
            padding-bottom: 12px;
            border-bottom: 1px solid var(--border-color);
        }

        .customer-detail-title {
            font-size: 1rem;
            font-weight: 700;
            color: var(--text-dark);
        }

        .churn-indicator {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 16px;
            border-radius: 20px;
            font-weight: 700;
            font-size: 0.9rem;
        }

        .churn-high {
            background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%);
            color: var(--danger-red);
            border: 1px solid #fecaca;
        }

        .churn-low {
            background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
            color: var(--success-green);
            border: 1px solid #bbf7d0;
        }

        .churn-medium {
            background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%);
            color: var(--warning-orange);
            border: 1px solid #fcd34d;
        }

        .detail-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
        }

        .detail-item {
            background: white;
            padding: 14px;
            border-radius: 10px;
            border: 1px solid var(--border-color);
        }

        .detail-label {
            font-size: 0.8rem;
            color: var(--text-gray);
            margin-bottom: 4px;
        }

        .detail-value {
            font-size: 1rem;
            font-weight: 600;
            color: var(--text-dark);
        }

        .consultation-log {
            grid-column: span 4;
            background: white;
            padding: 16px;
            border-radius: 10px;
            border: 1px solid var(--border-color);
            max-height: 200px;
            overflow-y: auto;
        }

        .consultation-log pre {
            font-family: inherit;
            font-size: 0.9rem;
            line-height: 1.6;
            white-space: pre-wrap;
            word-wrap: break-word;
            color: var(--text-dark);
        }

        /* --- Loading & Error --- */
        .loading {
            display: none;
            align-items: center;
            justify-content: center;
            padding: 40px;
        }

        .loading.show {
            display: flex;
        }

        .spinner {
            width: 40px;
            height: 40px;
            border: 4px solid var(--border-color);
            border-top-color: var(--primary-blue);
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        .error-message {
            display: none;
            padding: 16px;
            background: #fef2f2;
            border: 1px solid #fecaca;
            border-radius: 8px;
            color: var(--danger-red);
            margin-top: 16px;
        }

        .error-message.show {
            display: block;
        }

        @keyframes blink {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.3; }
        }

        /* ============================================
           토스트 알림 스타일
           ============================================ */
        .toast-container {
            position: fixed;
            top: 90px;
            right: 24px;
            z-index: 1000;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .toast {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 16px 20px;
            background: white;
            border-radius: 12px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15), 0 4px 12px rgba(0, 0, 0, 0.1);
            border: 1px solid var(--border-color);
            min-width: 320px;
            max-width: 400px;
            transform: translateX(120%);
            transition: transform 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55);
        }

        .toast.show {
            transform: translateX(0);
        }

        .toast.churn-alert {
            border-left: 4px solid var(--danger-red);
            background: linear-gradient(135deg, #fff 0%, #fef2f2 100%);
        }

        .toast-icon {
            width: 48px;
            height: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
            border-radius: 10px;
            font-size: 24px;
            flex-shrink: 0;
            animation: iconPulse 1.5s infinite;
        }

        @keyframes iconPulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.05); }
        }

        .toast-content {
            flex: 1;
        }

        .toast-title {
            font-size: 1rem;
            font-weight: 700;
            color: var(--text-dark);
            margin-bottom: 4px;
        }

        .toast-message {
            font-size: 0.9rem;
            color: var(--primary-blue);
            font-weight: 500;
        }

        .toast-actions {
            display: flex;
            flex-direction: column;
            gap: 8px;
            align-items: flex-end;
        }

        .toast-close {
            width: 24px;
            height: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: transparent;
            border: none;
            color: var(--text-gray);
            font-size: 18px;
            cursor: pointer;
            border-radius: 4px;
            transition: all 0.2s;
        }

        .toast-close:hover {
            background: var(--bg-color);
            color: var(--text-dark);
        }

        .toast-btn {
            padding: 8px 16px;
            background: var(--danger-red);
            color: white;
            border: none;
            border-radius: 6px;
            font-size: 0.85rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            white-space: nowrap;
        }

        .toast-btn:hover {
            background: #dc2626;
            transform: scale(1.02);
        }

        /* ============================================
           이탈 위험 분석 탭 스타일
           ============================================ */
        .churn-analysis-content {
            display: flex;
            gap: 24px;
            width: 100%;
        }

        .churn-left {
            flex: 2;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .churn-right {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        /* Risk Score Card */
        .risk-score-card {
            background: linear-gradient(135deg, #fef2f2 0%, #fff 100%);
            border: 2px solid #fecaca;
            transition: all 0.3s ease;
        }

        .risk-score-card.medium-risk {
            background: linear-gradient(135deg, #fffbeb 0%, #fff 100%);
            border: 2px solid #fcd34d;
        }

        .risk-score-card.medium-risk .risk-gauge-bg {
            stroke: #fcd34d;
        }

        .risk-score-content {
            display: flex;
            align-items: center;
            gap: 24px;
        }

        .risk-gauge {
            position: relative;
            width: 120px;
            height: 120px;
        }

        .risk-gauge svg {
            transform: rotate(-90deg);
        }

        .risk-gauge-bg {
            fill: none;
            stroke: #fecaca;
            stroke-width: 12;
        }

        .risk-gauge-fill {
            fill: none;
            stroke: var(--danger-red);
            stroke-width: 12;
            stroke-linecap: round;
            stroke-dasharray: 339.3;
            stroke-dashoffset: 339.3;
            transition: stroke-dashoffset 1s ease;
        }

        .risk-percentage {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-size: 28px;
            font-weight: 800;
            color: var(--danger-red);
        }

        .risk-info {
            flex: 1;
        }

        .risk-info h3 {
            font-size: 1.2rem;
            color: var(--danger-red);
            margin-bottom: 8px;
        }

        .risk-factors {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .risk-factor-badge {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 6px 12px;
            background: white;
            border: 1px solid #fecaca;
            border-radius: 20px;
            font-size: 0.85rem;
            color: var(--danger-red);
        }

        /* Analysis Cards */
        .analysis-card h3 {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 1rem;
            margin-bottom: 16px;
            color: var(--text-dark);
        }

        .analysis-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .analysis-item {
            display: flex;
            gap: 14px;
            padding: 14px;
            background: var(--bg-color);
            border-radius: 10px;
            transition: all 0.2s;
        }

        .analysis-item:hover {
            background: var(--primary-light);
        }

        .analysis-icon {
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 10px;
            font-size: 20px;
            flex-shrink: 0;
        }

        .analysis-icon.billing { background: #fff7ed; }
        .analysis-icon.quality { background: #eff6ff; }
        .analysis-icon.service { background: #f5f3ff; }

        .analysis-text {
            flex: 1;
        }

        .analysis-category {
            font-size: 0.8rem;
            color: var(--text-gray);
            margin-bottom: 4px;
        }

        .analysis-description {
            font-size: 0.95rem;
            color: var(--text-dark);
        }

        /* Action Card */
        .action-card {
            background: linear-gradient(135deg, #eff6ff 0%, #fff 100%);
            border: 1px solid #bfdbfe;
        }

        .action-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .action-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 16px;
            background: white;
            border-radius: 8px;
            font-size: 0.95rem;
            transition: all 0.2s;
        }

        .action-item:hover {
            transform: translateX(4px);
            background: var(--primary-light);
        }

        .action-number {
            width: 24px;
            height: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--primary-blue);
            color: white;
            font-size: 12px;
            font-weight: 700;
            border-radius: 6px;
        }

        /* Script Card */
        .script-card {
            background: linear-gradient(135deg, #f0fdfa 0%, #fff 100%);
            border: 1px solid #99f6e4;
        }

        .script-content {
            position: relative;
            padding: 20px;
            background: white;
            border-radius: 10px;
            border-left: 4px solid #14b8a6;
        }

        .script-content::before {
            content: '"';
            position: absolute;
            top: 10px;
            left: 16px;
            font-size: 48px;
            color: rgba(20, 184, 166, 0.2);
            font-family: Georgia, serif;
            line-height: 1;
        }

        .script-text {
            font-size: 0.95rem;
            line-height: 1.8;
            color: var(--text-dark);
            padding-left: 24px;
            font-style: italic;
        }

        .copy-btn {
            position: absolute;
            top: 12px;
            right: 12px;
            padding: 6px 12px;
            background: #14b8a6;
            border: none;
            border-radius: 6px;
            color: white;
            font-size: 0.8rem;
            cursor: pointer;
            transition: all 0.2s;
        }

        .copy-btn:hover {
            background: #0d9488;
        }
    </style>
</head>
<body>

    <!-- 토스트 알림 컨테이너 -->
    <div class="toast-container" id="toastContainer"></div>

    <header>
