    <script>
        const API_BASE = 'http://127.0.0.1:8000';
        let currentCustomer = null;

        // Timer
        let seconds = 0;
        let timerInterval = null;

        function startTimer() {
            if (timerInterval) return; // 이미 실행 중이면 무시
            timerInterval = setInterval(() => {
                seconds++;
                updateTimerDisplay();
            }, 1000);
        }

        function updateTimerDisplay() {
            const h = Math.floor(seconds / 3600);
            const m = Math.floor((seconds % 3600) / 60);
            const s = seconds % 60;
            document.getElementById('timer').textContent = 
                `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
        }

        // 받기 버튼 클릭 - 타이머 시작
        function answerCall() {
            startTimer();
        }

        // 끊기 버튼 클릭 - 타이머 중지 및 초기화
        function endCall() {
            // 타이머 중지
            if (timerInterval) {
                clearInterval(timerInterval);
                timerInterval = null;
            }
            // 타이머 0으로 초기화
            seconds = 0;
            updateTimerDisplay();
        }

        // Main Tab 전환
        function switchMainTab(tabId) {
            // 탭 버튼 활성화
            document.querySelectorAll('.main-tab').forEach(tab => {
                tab.classList.remove('active');
                if (tab.dataset.tab === tabId) {
                    tab.classList.add('active');
                }
            });

            // 탭 컨텐츠 전환
            document.querySelectorAll('.tab-content').forEach(content => {
                content.classList.remove('active');
            });

            if (tabId === 'consultation') {
                document.getElementById('consultationTab').classList.add('active');
            } else if (tabId === 'churn-analysis') {
                document.getElementById('churnAnalysisTab').classList.add('active');
            }
        }

        // 이탈 위험 분석 탭 닫기
        function closeChurnTab(event) {
            event.stopPropagation();
            document.getElementById('churnTab').style.display = 'none';
            switchMainTab('consultation');
        }

        // 이탈 위험 분석 탭 표시
        function showChurnTab() {
            document.getElementById('churnTab').style.display = 'flex';
        }

        // 토스트 알림 표시
        function showChurnToast(customer, riskScore) {
            const container = document.getElementById('toastContainer');
            
            // 기존 토스트 제거
            container.innerHTML = '';
            
            const toast = document.createElement('div');
            toast.className = 'toast churn-alert';
            toast.innerHTML = `
                <div class="toast-icon">⚠️</div>
                <div class="toast-content">
                    <div class="toast-title">이상 고객 발견!</div>
                    <div class="toast-message">${customer.customerID} · 이탈 위험도 ${riskScore}%</div>
                </div>
                <div class="toast-actions">
                    <button class="toast-close" onclick="closeToast(this)">✕</button>
                    <button class="toast-btn" onclick="handleToastConfirm()">확인하기</button>
                </div>
            `;
            
            container.appendChild(toast);
            
            // 애니메이션을 위해 약간의 딜레이 후 show 클래스 추가
            setTimeout(() => {
                toast.classList.add('show');
            }, 100);
            
            // 10초 후 자동으로 닫기
            setTimeout(() => {
                if (toast.parentElement) {
                    toast.classList.remove('show');
                    setTimeout(() => toast.remove(), 400);
                }
            }, 10000);
        }

        // 토스트 닫기
        function closeToast(btn) {
            const toast = btn.closest('.toast');
            toast.classList.remove('show');
            setTimeout(() => toast.remove(), 400);
        }

        // 토스트 확인하기 버튼 클릭
        function handleToastConfirm() {
            // 토스트 닫기
            const container = document.getElementById('toastContainer');
            const toast = container.querySelector('.toast');
            if (toast) {
                toast.classList.remove('show');
                setTimeout(() => toast.remove(), 400);
            }
            
            // 이탈 위험 분석 탭으로 이동
            switchMainTab('churn-analysis');
        }

        // 이탈 위험 분석 데이터 업데이트
        function updateChurnAnalysis(customer) {
            // 위험도 계산 (Churn_Probability 활용, 없으면 label 기반)
            let riskScore;
            if (customer.Churn_Probability !== undefined && customer.Churn_Probability !== null) {
                riskScore = Math.round(customer.Churn_Probability * 100);
            } else {
                riskScore = customer.label === 1 ? 85 + Math.floor(Math.random() * 10) : 30 + Math.floor(Math.random() * 20);
            }
            
            // 게이지 애니메이션
            const gauge = document.getElementById('riskGaugeFill');
            const circumference = 339.3;
            const offset = circumference - (riskScore / 100) * circumference;
            gauge.style.strokeDashoffset = offset;
            
            // 게이지 색상 변경
            if (riskScore >= 80) {
                gauge.style.stroke = 'var(--danger-red)';
            } else {
                gauge.style.stroke = 'var(--warning-orange)';
            }
            
            document.getElementById('riskPercentage').textContent = riskScore + '%';
            document.getElementById('riskCustomerName').textContent = customer.customer_name + ' 고객';
            
            // 퍼센트 색상 변경
            const percentageEl = document.getElementById('riskPercentage');
            if (riskScore >= 80) {
                percentageEl.style.color = 'var(--danger-red)';
            } else {
                percentageEl.style.color = 'var(--warning-orange)';
            }
            
            // 위험 배지: 80% 이상 HIGH RISK(빨강), 55%~79% MEDIUM RISK(주황)
            const badge = document.getElementById('riskBadge');
            const riskCard = document.querySelector('.risk-score-card');
            const gaugeBg = document.querySelector('.risk-gauge-bg');
            
            if (riskScore >= 80) {
                badge.textContent = 'HIGH RISK';
                badge.className = 'badge badge-red';
                riskCard.classList.remove('medium-risk');
                gaugeBg.style.stroke = '#fecaca';
            } else {
                badge.textContent = 'MEDIUM RISK';
                badge.className = 'badge badge-orange';
                riskCard.classList.add('medium-risk');
                gaugeBg.style.stroke = '#fcd34d';
            }

            // 위험 요인
            const factors = [];
            if (customer.issue_category === '요금') factors.push('💰 요금 불만');
            if (customer.repeat_contacts_7d > 1) factors.push('📞 반복 문의 ' + customer.repeat_contacts_7d + '회');
            if (customer.wait_time_sec > 30) factors.push('⏱️ 대기 ' + customer.wait_time_sec + '초');
            if (customer.billing_issue_flag) factors.push('🧾 청구 문제');
            if (customer.usage_change_score < 0) factors.push('📉 사용량 감소');
            
            document.getElementById('riskFactors').innerHTML = factors.length > 0 
                ? factors.map(f => `<span class="risk-factor-badge">${f}</span>`).join('')
                : '<span class="risk-factor-badge">특이사항 없음</span>';

            // 요약 정보
            document.getElementById('summaryCustomerId').textContent = customer.customerID || '-';
            document.getElementById('summaryContract').textContent = customer.Contract || '-';
            document.getElementById('summaryTenure').textContent = customer.tenure ? customer.tenure + '개월' : '-';
            document.getElementById('summaryMonthly').textContent = customer.MonthlyCharges ? '$' + customer.MonthlyCharges : '-';
            document.getElementById('summaryIssue').textContent = customer.issue_category || '-';

            // 스크립트 업데이트
            updateScript(customer);
        }

        // 상담 스크립트 업데이트
        function updateScript(customer) {
            let script = '';
            if (customer.issue_category === '요금') {
                script = `${customer.customer_name} 고객님, 최근 요금이 높게 청구된 점 불편하셨죠. 자동 갱신된 서비스가 있는지 확인 중입니다. 현재 이용 패턴 기준 더 적합한 요금제가 있어 비교해드리겠습니다.`;
            } else if (customer.issue_category === '품질') {
                script = `${customer.customer_name} 고객님, 서비스 품질에 불편을 드려 죄송합니다. 현재 회선 상태를 점검해드리고, 필요시 기사 방문을 예약해드리겠습니다.`;
            } else {
                script = `${customer.customer_name} 고객님, 문의 주셔서 감사합니다. ${customer.tenure}개월간 저희 서비스를 이용해주셔서 감사드리며, 어떤 부분이 불편하셨는지 자세히 말씀해 주시면 최선을 다해 도와드리겠습니다.`;
            }
            document.getElementById('scriptText').textContent = script;
        }

        // 스크립트 복사
        function copyScript() {
            const text = document.getElementById('scriptText').textContent;
            navigator.clipboard.writeText(text).then(() => {
                const btn = document.querySelector('.copy-btn');
                btn.textContent = '✓ 복사됨';
                setTimeout(() => { btn.textContent = '📋 복사'; }, 2000);
            });
        }

        // 고객 조회
        async function searchCustomer() {
            const name = document.getElementById('customerName').value.trim();
            const phone = document.getElementById('customerPhone').value.trim();

            if (!name && !phone) {
                showError('고객명 또는 핸드폰 번호를 입력해주세요.');
                return;
            }

            hideError();
            hideDetail();
            showLoading();

            try {
                const params = new URLSearchParams();
                if (name) params.append('name', name);
                if (phone) params.append('phone', phone);

                const response = await fetch(`${API_BASE}/search/customer?${params.toString()}`);
                
                if (!response.ok) {
                    const error = await response.json();
                    throw new Error(error.detail || '조회에 실패했습니다.');
                }

                const data = await response.json();
                
                if (data.count === 0) {
                    throw new Error('해당 조건에 맞는 고객이 없습니다.');
                }

                currentCustomer = data.customers[0];
                displayCustomerData(currentCustomer);
                
            } catch (error) {
                showError(error.message);
            } finally {
                hideLoading();
            }
        }

        // 고객 데이터 표시
        function displayCustomerData(customer) {
            document.getElementById('customerName').value = customer.customer_name || '';
            document.getElementById('customerPhone').value = formatPhone(customer.contact_number) || '';
            document.getElementById('customerId').value = customer.customerID || '';
            document.getElementById('contractType').value = customer.Contract || '';
            document.getElementById('tenure').value = customer.tenure ? `${customer.tenure}개월` : '';

            document.getElementById('detailGender').textContent = customer.gender === 'True' || customer.gender === true ? '여성' : '남성';
            document.getElementById('detailSenior').textContent = customer.SeniorCitizen === 'True' || customer.SeniorCitizen === true ? '예' : '아니오';
            document.getElementById('detailMonthly').textContent = customer.MonthlyCharges ? `$${customer.MonthlyCharges}` : '-';
            document.getElementById('detailTotal').textContent = customer.TotalCharges ? `$${customer.TotalCharges}` : '-';
            document.getElementById('detailInternet').textContent = customer.InternetService || '-';
            document.getElementById('detailPayment').textContent = customer.PaymentMethod || '-';
            document.getElementById('detailIssue').textContent = customer.issue_category || '-';
            document.getElementById('detailRepeat').textContent = customer.repeat_contacts_7d ? `${customer.repeat_contacts_7d}회` : '-';
            document.getElementById('detailConsultation').textContent = '상담 내역이 없습니다.';

            const churnIndicator = document.getElementById('churnIndicator');
            const churnIcon = document.getElementById('churnIcon');
            const churnText = document.getElementById('churnText');
            
            // 위험도 계산 (Churn_Probability 기준)
            let riskScore = 0;
            if (customer.Churn_Probability !== undefined && customer.Churn_Probability !== null) {
                riskScore = Math.round(customer.Churn_Probability * 100);
            } else if (customer.label === 1) {
                riskScore = 85 + Math.floor(Math.random() * 10);
            }
            
            // 55% 이상일 때만 이탈 위험으로 처리
            const isChurnRisk = riskScore >= 55;
            
            if (isChurnRisk) {
                // 80% 이상: 빨강, 55~79%: 주황
                if (riskScore >= 80) {
                    churnIndicator.className = 'churn-indicator churn-high';
                    churnIcon.textContent = '🚨';
                    churnText.textContent = '고위험 이탈 고객';
                } else {
                    churnIndicator.className = 'churn-indicator churn-medium';
                    churnIcon.textContent = '⚠️';
                    churnText.textContent = '이탈 위험 고객';
                }
                
                // 이탈 위험 분석 탭 표시
                showChurnTab();
                updateChurnAnalysis(customer);
                
                // 토스트 표시
                showChurnToast(customer, riskScore);
            } else {
                churnIndicator.className = 'churn-indicator churn-low';
                churnIcon.textContent = '✅';
                churnText.textContent = '정상 고객';
                
                // 이탈 위험 분석 탭 숨기기
                document.getElementById('churnTab').style.display = 'none';
            }

            if (customer.issue_category) {
                document.getElementById('category1').value = customer.issue_category;
            }

            updateHistoryTable(customer);
            showDetail();
        }

        function updateHistoryTable(customer) {
            const tbody = document.getElementById('historyTableBody');
            const now = new Date();
            const dateStr = `${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,'0')}-${String(now.getDate()).padStart(2,'0')} ${String(now.getHours()).padStart(2,'0')}:${String(now.getMinutes()).padStart(2,'0')}`;
            const callDuration = customer.call_duration_sec ? formatDuration(customer.call_duration_sec) : '00:00:00';
            
            tbody.innerHTML = `
                <tr>
                    <td>${dateStr}</td>
                    <td>관리자01</td>
                    <td><span class="badge ${customer.issue_category === '요금' ? 'badge-orange' : 'badge-blue'}">${customer.issue_category || '일반'}</span></td>
                    <td>상담진행</td>
                    <td>${callDuration}</td>
                </tr>
            `;
        }

        function formatPhone(phone) {
            if (!phone) return '';
            const cleaned = String(phone).replace(/\D/g, '');
            if (cleaned.length === 11) {
                return `${cleaned.slice(0,3)}-${cleaned.slice(3,7)}-${cleaned.slice(7)}`;
            }
            return phone;
        }

        function formatDuration(seconds) {
            const h = Math.floor(seconds / 3600);
            const m = Math.floor((seconds % 3600) / 60);
            const s = seconds % 60;
            return `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
        }

        function resetForm() {
            document.getElementById('customerName').value = '';
            document.getElementById('customerPhone').value = '';
            document.getElementById('homePhone').value = '';
            document.getElementById('customerEmail').value = '';
            document.getElementById('customerId').value = '';
            document.getElementById('contractType').value = '';
            document.getElementById('tenure').value = '';
            document.getElementById('customerMemo').value = '';
            document.getElementById('inquiryContent').value = '';
            document.getElementById('actionContent').value = '';
            
            hideDetail();
            hideError();
            document.getElementById('churnTab').style.display = 'none';
            switchMainTab('consultation');
            
            document.getElementById('historyTableBody').innerHTML = `
                <tr>
                    <td colspan="5" style="text-align:center; color:var(--text-gray);">고객을 조회해주세요.</td>
                </tr>
            `;
            currentCustomer = null;
        }

        function showLoading() { document.getElementById('loading').classList.add('show'); }
        function hideLoading() { document.getElementById('loading').classList.remove('show'); }
        function showError(message) {
            const el = document.getElementById('errorMessage');
            el.textContent = '❌ ' + message;
            el.classList.add('show');
        }
        function hideError() { document.getElementById('errorMessage').classList.remove('show'); }
        function showDetail() { document.getElementById('customerDetail').classList.add('show'); }
        function hideDetail() { document.getElementById('customerDetail').classList.remove('show'); }

        // Enter 키로 검색
        document.getElementById('customerName').addEventListener('keypress', (e) => {
            if (e.key === 'Enter') searchCustomer();
        });
        document.getElementById('customerPhone').addEventListener('keypress', (e) => {
            if (e.key === 'Enter') searchCustomer();
        });
    </script>
</body>
</html>
