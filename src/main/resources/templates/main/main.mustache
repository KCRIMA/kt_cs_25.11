    <script>
        const API_BASE = 'http://127.0.0.1:8000';
        let currentCustomer = null;

        // 전화 대기 큐
        let callQueue = [
            '010-0525-0309',
            '010-1331-7181',
            '010-8400-8327',
            '010-0299-5900'
        ];
        // contact_number 전체 풀 (백엔드에서 받아온 걸로 채우면 됨)
        let contactPool = [];   // ← 백엔드에서 받은 값으로 채워질 예정

        // 랜덤 연락처 하나 뽑기
        function getRandomContactNumber() {
            if (contactPool.length === 0) return null;
            const idx = Math.floor(Math.random() * contactPool.length);
            return contactPool[idx];
        }

        // Timer
        let seconds = 0;
        let timerInterval = null;

        //  오늘 세션 기준 통계 (프론트에서만 관리)
        let totalCallSeconds = 0;  // 통화 누적
        let callCount = 0;         // 통화 건수
        let totalWaitSeconds = 0;   // 대기 누적
        let waitCount = 0;         // 대기 건수
        let waitStartTime = null;  // 대기 시작 시각

        //  방금 조회한 고객의 히스토리 row를 기억
        let currentHistoryRow = null;

        let incomingCallTimer = null;

        let agentStatus = 'ready'; // 글로벌 상담사 상태

        // 대기 버튼 눌렀을 때
        document.getElementById('btnAway').addEventListener('click', () => {
            agentStatus = 'away';

            // 1) 새로운 콜 생성 타이머 중단
            if (incomingCallTimer) {
                clearTimeout(incomingCallTimer);
                incomingCallTimer = null;
            }

            // 2) 대기 고객 토스트 감추기
            hideCallRequestToast();

            console.log('상담사 상태: 이석 → 신규 콜 생성 중단 + 토스트 숨김');
        });

        document.getElementById('btnReady').addEventListener('click', () => {
            agentStatus = 'ready';

            waitStartTime = new Date();

            // 1) 대기 고객 토스트 다시 표시
            showCallRequestToast();

            // 2) 콜 생성 스케줄 재시작
            scheduleNextIncomingCall();

            console.log('상담사 상태: 대기 → 신규 콜 생성 재시작');
        });



        function startTimer() {
            if (timerInterval) return; // 이미 실행 중이면 무시
            timerInterval = setInterval(() => {
                seconds++;
                updateTimerDisplay();
            }, 1000);
        }

        function updateTimerDisplay() {
            const h = Math.floor(seconds / 3600);
            const m = Math.floor((seconds % 3600) / 60);
            const s = seconds % 60;
            document.getElementById('timer').textContent = 
                `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
        }

        // 받기 버튼 클릭 - 타이머 시작
        function answerCall() {
            startTimer();

            //  대기시간 계산
            if (waitStartTime) {
                const now = new Date();
                const waitSec = Math.round((now - waitStartTime) / 1000);
                totalWaitSeconds += waitSec;
                waitCount += 1;
                waitStartTime = null;
                updateWaitStatsUI();   // 화면 업데이트
            }

            // 🔹 현재 통화중인 번호 = 대기열 맨 앞 번호
            const currentNumber = callQueue[0];
            if (currentNumber) {
                // 0) 이전 고객 이름/ID 등 검색 키 값 초기화
                document.getElementById('customerName').value = '';
                // 1) 고객 핸드폰 입력칸에 번호 넣고
                document.getElementById('customerPhone').value = currentNumber;
                // 2) 그 번호로 고객 조회 실행
                searchCustomer();
            }

            hideCallRequestToast();   // 통화 중에는 토스트 숨김
        }

        // 끊기 버튼 클릭 - 타이머 중지 및 초기화 + 대기 목록 갱신
        function endCall() {
            //  이번 통화 길이 저장
            const callDurationThisCall = seconds;  // 이번 통화 초 단위

            // 타이머 중지
            if (timerInterval) {
                clearInterval(timerInterval);
                timerInterval = null;
            }
            // 타이머 0으로 초기화
            seconds = 0;
            updateTimerDisplay();

            // 🔹 통화 통계 누적
            if (callDurationThisCall > 0) {
                totalCallSeconds += callDurationThisCall;
                callCount += 1;
                updateCallStatsUI();   // 평균 통화 시간 화면 갱신
            }

            //  히스토리 테이블의 소요시간과 상태를 실제 통화시간으로 업데이트
            if (currentHistoryRow) {
                const tds = currentHistoryRow.querySelectorAll('td');
                // 4번째 칸(처리상태)
                tds[3].textContent = '상담종료';
                // 5번째 칸(소요시간)
                tds[4].textContent = formatDuration(callDurationThisCall);
            }

            // 🔹 통화가 끝났으니, 맨 앞 전화번호 제거
            if (callQueue.length > 0) {
                callQueue.shift();   // 첫 번째 번호 제거
            }

            // 🔹 남은 번호가 있으면 토스트 다시 표시
            if (callQueue.length > 0) {
                showCallRequestToast();
            } else {
                hideCallRequestToast();
            }
        }


        // Main Tab 전환
        function switchMainTab(tabId) {
            // 탭 버튼 활성화
            document.querySelectorAll('.main-tab').forEach(tab => {
                tab.classList.remove('active');
                if (tab.dataset.tab === tabId) {
                    tab.classList.add('active');
                }
            });

            // 탭 컨텐츠 전환
            document.querySelectorAll('.tab-content').forEach(content => {
                content.classList.remove('active');
            });

            if (tabId === 'consultation') {
                document.getElementById('consultationTab').classList.add('active');
            } else if (tabId === 'churn-analysis') {
                document.getElementById('churnAnalysisTab').classList.add('active');
            }
        }

        // 이탈 위험 분석 탭 닫기
        function closeChurnTab(event) {
            event.stopPropagation();
            document.getElementById('churnTab').style.display = 'none';
            switchMainTab('consultation');
        }

        // 이탈 위험 분석 탭 표시
        function showChurnTab() {
            document.getElementById('churnTab').style.display = 'flex';
        }

        // 토스트 알림 표시
        function showChurnToast(customer, riskScore) {
            const container = document.getElementById('toastContainer');
            
            // 기존 토스트 제거
            container.innerHTML = '';
            
            const toast = document.createElement('div');
            toast.className = 'toast churn-alert';
            toast.innerHTML = `
                <div class="toast-icon">⚠️</div>
                <div class="toast-content">
                    <div class="toast-title">이상 고객 발견!</div>
                    <div class="toast-message">${customer.customerID} · 이탈 위험도 ${riskScore}%</div>
                </div>
                <div class="toast-actions">
                    <button class="toast-close" onclick="closeToast(this)">✕</button>
                    <button class="toast-btn" onclick="handleToastConfirm()">확인하기</button>
                </div>
            `;
            
            container.appendChild(toast);
            
            // 애니메이션을 위해 약간의 딜레이 후 show 클래스 추가
            setTimeout(() => {
                toast.classList.add('show');
            }, 100);
            
            // 10초 후 자동으로 닫기
            setTimeout(() => {
                if (toast.parentElement) {
                    toast.classList.remove('show');
                    setTimeout(() => toast.remove(), 400);
                }
            }, 10000);
        }

        // 토스트 닫기
        function closeToast(btn) {
            const toast = btn.closest('.toast');
            toast.classList.remove('show');
            setTimeout(() => toast.remove(), 400);
        }

        // 토스트 확인하기 버튼 클릭
        function handleToastConfirm() {
            // 토스트 닫기
            const container = document.getElementById('toastContainer');
            const toast = container.querySelector('.toast');
            if (toast) {
                toast.classList.remove('show');
                setTimeout(() => toast.remove(), 400);
            }
            
            // 이탈 위험 분석 탭으로 이동
            switchMainTab('churn-analysis');
        }

        // 이탈 위험 분석 데이터 업데이트
        function updateChurnAnalysis(customer) {
            // 위험도 계산 (Churn_Probability 활용, 없으면 label 기반)
            let riskScore;
            if (customer.Churn_Probability !== undefined && customer.Churn_Probability !== null) {
                riskScore = Math.round(customer.Churn_Probability * 100);
            } else {
                riskScore = customer.label === 1 ? 85 + Math.floor(Math.random() * 10) : 30 + Math.floor(Math.random() * 20);
            }
            
            // 게이지 애니메이션
            const gauge = document.getElementById('riskGaugeFill');
            const circumference = 339.3;
            const offset = circumference - (riskScore / 100) * circumference;
            gauge.style.strokeDashoffset = offset;
            
            // 게이지 색상 변경
            if (riskScore >= 80) {
                gauge.style.stroke = 'var(--danger-red)';
            } else {
                gauge.style.stroke = 'var(--warning-orange)';
            }
            
            document.getElementById('riskPercentage').textContent = riskScore + '%';
            document.getElementById('riskCustomerName').textContent = customer.customer_name + ' 고객';
            
            // 퍼센트 색상 변경
            const percentageEl = document.getElementById('riskPercentage');
            if (riskScore >= 80) {
                percentageEl.style.color = 'var(--danger-red)';
            } else {
                percentageEl.style.color = 'var(--warning-orange)';
            }
            
            // 위험 배지: 80% 이상 HIGH RISK(빨강), 55%~79% MEDIUM RISK(주황)
            const badge = document.getElementById('riskBadge');
            const riskCard = document.querySelector('.risk-score-card');
            const gaugeBg = document.querySelector('.risk-gauge-bg');
            
            if (riskScore >= 80) {
                badge.textContent = 'HIGH RISK';
                badge.className = 'badge badge-red';
                riskCard.classList.remove('medium-risk');
                gaugeBg.style.stroke = '#fecaca';
            } else {
                badge.textContent = 'MEDIUM RISK';
                badge.className = 'badge badge-orange';
                riskCard.classList.add('medium-risk');
                gaugeBg.style.stroke = '#fcd34d';
            }

            // 위험 요인
            const factors = [];
            if (customer.issue_category) {
                const icon =
                        customer.issue_category === '요금' ? '💰' :
                                customer.issue_category === '품질' ? '📶' :
                                        '💬'; // 기타

                factors.push(`${icon} ${customer.issue_category} 불만`);
            }
            if (customer.repeat_contacts_7d > 1) factors.push('📞 반복 문의 ' + customer.repeat_contacts_7d + '회');
            if (customer.wait_time_sec > 30) factors.push('⏱️ 대기 ' + customer.wait_time_sec + '초');
            if (customer.billing_issue_flag) factors.push('🧾 청구 문제');
            if (customer.usage_change_score < 0) factors.push('📉 사용량 감소');
            
            document.getElementById('riskFactors').innerHTML = factors.length > 0 
                ? factors.map(f => `<span class="risk-factor-badge">${f}</span>`).join('')
                : '<span class="risk-factor-badge">특이사항 없음</span>';

            // 요약 정보
            document.getElementById('summaryCustomerId').textContent = formatCustomerId(customer.customerID);
            document.getElementById('summaryContract').textContent = formatContract(customer.Contract);
            document.getElementById('summaryTenure').textContent = customer.tenure ? customer.tenure + '개월' : '-';
            document.getElementById('summaryMonthly').textContent = formatCurrencyKRW(customer.MonthlyCharges);
            document.getElementById('summaryIssue').textContent = customer.issue_category || '-';

            // 스크립트 업데이트
            updateScript(customer);
        }

        // 상담 스크립트 업데이트
        function updateScript(customer) {
            let script = '';
            if (customer.issue_category === '요금') {
                script = `${customer.customer_name} 고객님, 최근 요금이 높게 청구된 점 불편하셨죠. 자동 갱신된 서비스가 있는지 확인 중입니다. 현재 이용 패턴 기준 더 적합한 요금제가 있어 비교해드리겠습니다.`;
            } else if (customer.issue_category === '품질') {
                script = `${customer.customer_name} 고객님, 서비스 품질에 불편을 드려 죄송합니다. 현재 회선 상태를 점검해드리고, 필요시 기사 방문을 예약해드리겠습니다.`;
            } else {
                script = `${customer.customer_name} 고객님, 문의 주셔서 감사합니다. ${customer.tenure}개월간 저희 서비스를 이용해주셔서 감사드리며, 어떤 부분이 불편하셨는지 자세히 말씀해 주시면 최선을 다해 도와드리겠습니다.`;
            }
            document.getElementById('scriptText').textContent = script;
        }

        // 스크립트 복사
        function copyScript() {
            const text = document.getElementById('scriptText').textContent;
            navigator.clipboard.writeText(text).then(() => {
                const btn = document.querySelector('.copy-btn');
                btn.textContent = '✓ 복사됨';
                setTimeout(() => { btn.textContent = '📋 복사'; }, 2000);
            });
        }

        function normalizePhoneForSearch(phone) {
            if (!phone) return '';

            // 1) 숫자만 남기기
            let digits = phone.replace(/\D/g, '');  // 010-0000-0000 -> 01000000000

            // 2) 맨 앞 0들 제거 (01000000000 -> 1000000000)
            digits = digits.replace(/^0+/, '');

            return digits;
        }

        // 고객 조회
        async function searchCustomer() {
            const name = document.getElementById('customerName').value.trim();
            const rawPhone = document.getElementById('customerPhone').value.trim();

            if (!name && !rawPhone) {
                showError('고객명 또는 핸드폰 번호를 입력해주세요.');
                return;
            }

            hideError();
            hideDetail();
            showLoading();

            try {
                const params = new URLSearchParams();
                if (name) params.append('name', name);
                // 🔹 여기서만 0 + 하이픈 제거해서 API로 보냄
                if (rawPhone) {
                    const normalized = normalizePhoneForSearch(rawPhone); // 예: 010-0000-0000 -> 1000000000
                    params.append('phone', normalized);
                }

                const response = await fetch(`${API_BASE}/search/customer?${params.toString()}`);
                
                if (!response.ok) {
                    const error = await response.json();
                    throw new Error(error.detail || '조회에 실패했습니다.');
                }

                const data = await response.json();
                
                if (data.count === 0) {
                    throw new Error('해당 조건에 맞는 고객이 없습니다.');
                }

                currentCustomer = data.customers[0];
                displayCustomerData(currentCustomer);
                
            } catch (error) {
                showError(error.message);
            } finally {
                hideLoading();
            }
        }

        // 고객 데이터 표시
        function displayCustomerData(customer) {
            document.getElementById('customerName').value = customer.customer_name || '';
            document.getElementById('customerPhone').value = formatPhone(customer.contact_number) || '';
            document.getElementById('customerId').value = formatCustomerId(customer.customerID);
            document.getElementById('contractType').value = formatContract(customer.Contract);
            document.getElementById('tenure').value = customer.tenure ? `${customer.tenure}개월` : '';

            document.getElementById('detailGender').textContent = customer.gender === 'True' || customer.gender === true ? '여성' : '남성';
            document.getElementById('detailSenior').textContent = customer.SeniorCitizen === 'True' || customer.SeniorCitizen === true ? '예' : '아니오';
            document.getElementById('detailMonthly').textContent = formatCurrencyKRW(customer.MonthlyCharges);
            document.getElementById('detailTotal').textContent = formatCurrencyKRW(customer.TotalCharges);
            document.getElementById('detailInternet').textContent = translateInternetService(customer.InternetService);
            document.getElementById('detailPayment').textContent = translatePaymentMethod(customer.PaymentMethod);
            document.getElementById('detailIssue').textContent = customer.issue_category || '-';
            document.getElementById('detailRepeat').textContent = customer.repeat_contacts_7d ? `${customer.repeat_contacts_7d}회` : '-';
            const summary =
                    customer.recent_summary_text ||  // 백엔드에서 별칭 만들었으면 이거
                    customer.summary_text;           // 아니면 원래 컬럼 이름

            document.getElementById('detailConsultation').textContent =
                    summary && summary.trim()
                            ? summary
                            : '상담 내역이 없습니다.';

            const churnIndicator = document.getElementById('churnIndicator');
            const churnIcon = document.getElementById('churnIcon');
            const churnText = document.getElementById('churnText');
            
            // 위험도 계산 (Churn_Probability 기준)
            let riskScore = 0;
            if (customer.Churn_Probability !== undefined && customer.Churn_Probability !== null) {
                riskScore = Math.round(customer.Churn_Probability * 100);
            } else if (customer.label === 1) {
                riskScore = 85 + Math.floor(Math.random() * 10);
            }
            
            // 55% 이상일 때만 이탈 위험으로 처리
            const isChurnRisk = riskScore >= 55;
            
            if (isChurnRisk) {
                // 80% 이상: 빨강, 55~79%: 주황
                if (riskScore >= 80) {
                    churnIndicator.className = 'churn-indicator churn-high';
                    churnIcon.textContent = '🚨';
                    churnText.textContent = '고위험 이탈 고객';
                } else {
                    churnIndicator.className = 'churn-indicator churn-medium';
                    churnIcon.textContent = '⚠️';
                    churnText.textContent = '이탈 위험 고객';
                }
                
                // 이탈 위험 분석 탭 표시
                showChurnTab();
                updateChurnAnalysis(customer);
                
                // 토스트 표시
                showChurnToast(customer, riskScore);
            } else {
                churnIndicator.className = 'churn-indicator churn-low';
                churnIcon.textContent = '✅';
                churnText.textContent = '정상 고객';
                
                // 이탈 위험 분석 탭 숨기기
                document.getElementById('churnTab').style.display = 'none';
            }

            if (customer.issue_category) {
                document.getElementById('category1').value = customer.issue_category;
            }

            updateHistoryTable(customer);
            showDetail();
        }


        function updateHistoryTable(customer) {
            const tbody = document.getElementById('historyTableBody');
            const now = new Date();
            const dateStr = `${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,'0')}-${String(now.getDate()).padStart(2,'0')} ${String(now.getHours()).padStart(2,'0')}:${String(now.getMinutes()).padStart(2,'0')}`;

            // 새 고객 조회 시 테이블 완전히 초기화
            tbody.innerHTML = '';

            // 7일내 반복문의 횟수 + 1 개의 행 생성
            // repeat_contacts_7d가 '-', null, undefined, 0인 경우 0으로 처리
            let repeatCount = customer.repeat_contacts_7d;
            if (!repeatCount || repeatCount === '-' || isNaN(Number(repeatCount))) {
                repeatCount = 0;
            } else {
                repeatCount = Number(repeatCount);
            }
            const totalRows = repeatCount + 1;

            // 1) 현재 통화 행 (맨 위에 추가)
            const currentTr = document.createElement('tr');
            currentTr.innerHTML = `
                <td>${dateStr}</td>
                <td>홍길동</td>
                <td><span class="badge ${customer.issue_category === '요금' ? 'badge-orange' : 'badge-blue'}">${customer.issue_category || '일반'}</span></td>
                <td>상담진행</td>
                <td>통화중</td>
            `;

            // 최신 통화를 맨 위에 쌓기
            if (tbody.firstChild) {
                tbody.insertBefore(currentTr, tbody.firstChild);
            } else {
                tbody.appendChild(currentTr);
            }

            // 🔹 나중에 endCall에서 업데이트할 수 있도록 행을 기억
            currentHistoryRow = currentTr;

            // 2) 과거 상담 내역 임의 생성 (repeatCount 개)
            const agents = ['홍길동', '김철수', '이영희', '박민수', '최지영'];
            const statuses = ['상담종료', '상담종료', '상담종료', '콜백완료'];
            const issueTypes = ['요금', '품질', '기타', '요금', '품질'];

            for (let i = 0; i < repeatCount; i++) {
                const pastTr = document.createElement('tr');
                
                // 과거 날짜 생성 (1~7일 전 랜덤)
                const daysAgo = Math.floor(Math.random() * 7) + 1;
                const pastDate = new Date(now);
                pastDate.setDate(pastDate.getDate() - daysAgo);
                pastDate.setHours(Math.floor(Math.random() * 12) + 8); // 8시~20시 사이
                pastDate.setMinutes(Math.floor(Math.random() * 60));
                
                const pastDateStr = `${pastDate.getFullYear()}-${String(pastDate.getMonth()+1).padStart(2,'0')}-${String(pastDate.getDate()).padStart(2,'0')} ${String(pastDate.getHours()).padStart(2,'0')}:${String(pastDate.getMinutes()).padStart(2,'0')}`;
                
                // 랜덤 상담사
                const randomAgent = agents[Math.floor(Math.random() * agents.length)];
                
                // 문의유형 (고객의 issue_category 또는 랜덤)
                const issueType = customer.issue_category || issueTypes[Math.floor(Math.random() * issueTypes.length)];
                
                // 랜덤 처리상태
                const randomStatus = statuses[Math.floor(Math.random() * statuses.length)];
                
                // 랜덤 소요시간 (1분~15분 사이)
                const randomMinutes = Math.floor(Math.random() * 14) + 1;
                const randomSeconds = Math.floor(Math.random() * 60);
                const durationStr = `00:${String(randomMinutes).padStart(2,'0')}:${String(randomSeconds).padStart(2,'0')}`;
                
                // 배지 색상 결정
                let badgeClass = 'badge-blue';
                if (issueType === '요금') badgeClass = 'badge-orange';
                else if (issueType === '품질') badgeClass = 'badge-blue';
                else badgeClass = 'badge-gray';
                
                pastTr.innerHTML = `
                    <td>${pastDateStr}</td>
                    <td>${randomAgent}</td>
                    <td><span class="badge ${badgeClass}">${issueType}</span></td>
                    <td>${randomStatus}</td>
                    <td>${durationStr}</td>
                `;
                
                // 현재 행 다음에 추가 (날짜 내림차순 유지)
                tbody.appendChild(pastTr);
            }

            // 과거 내역을 날짜순으로 정렬 (현재 행 제외하고)
            sortHistoryTableByDate(tbody);
        }

        // 상담내역 테이블을 날짜 내림차순으로 정렬
        function sortHistoryTableByDate(tbody) {
            const rows = Array.from(tbody.querySelectorAll('tr'));
            if (rows.length <= 1) return;

            // 현재 통화중인 행은 항상 맨 위에
            const currentRow = rows.find(row => row.querySelector('td:last-child')?.textContent === '통화중');
            const otherRows = rows.filter(row => row !== currentRow);

            // 나머지 행들을 날짜 내림차순 정렬
            otherRows.sort((a, b) => {
                const dateA = a.querySelector('td:first-child')?.textContent || '';
                const dateB = b.querySelector('td:first-child')?.textContent || '';
                return dateB.localeCompare(dateA);
            });

            // tbody 비우고 다시 채우기
            tbody.innerHTML = '';
            if (currentRow) tbody.appendChild(currentRow);
            otherRows.forEach(row => tbody.appendChild(row));
        }

        function formatPhone(phone) {
            if (!phone) return '';
            let digits = String(phone).replace(/\D/g, '');

            // 🔹 CSV가 1000000000(10자리, 1로 시작) 형태면 0을 앞에 붙여줌 → 01000000000
            if (digits.length === 10 && digits[0] === '1') {
                digits = '0' + digits;
            }
            if (digits.length === 11) {
                return `${digits.slice(0,3)}-${digits.slice(3,7)}-${digits.slice(7)}`;
            }
            return phone;
        }

        function formatDuration(seconds) {
            const h = Math.floor(seconds / 3600);
            const m = Math.floor((seconds % 3600) / 60);
            const s = seconds % 60;
            return `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
        }

        function updateCallStatsUI() {
            if (callCount === 0) return;

            const avg = Math.round(totalCallSeconds / callCount);
            document.getElementById('avgCallTime').textContent = formatDuration(avg);

            // 🔹 누적통화 UI도 함께 갱신
            document.getElementById('totalCallCount').textContent = callCount + '건';
        }

        function updateWaitStatsUI() {
            if (waitCount === 0) return;
            const avg = Math.round(totalWaitSeconds / waitCount);
            document.getElementById('avgWaitTime').textContent = formatDuration(avg);
        }

        function resetForm() {
            document.getElementById('customerName').value = '';
            document.getElementById('customerPhone').value = '';
            document.getElementById('homePhone').value = '';
            document.getElementById('customerEmail').value = '';
            document.getElementById('customerId').value = '';
            document.getElementById('contractType').value = '';
            document.getElementById('tenure').value = '';
            document.getElementById('customerMemo').value = '';
            document.getElementById('inquiryContent').value = '';
            document.getElementById('actionContent').value = '';
            
            hideDetail();
            hideError();
            document.getElementById('churnTab').style.display = 'none';
            switchMainTab('consultation');
            
            document.getElementById('historyTableBody').innerHTML = `
                <tr>
                    <td colspan="5" style="text-align:center; color:var(--text-gray);">고객을 조회해주세요.</td>
                </tr>
            `;
            currentCustomer = null;
        }

        function showLoading() { document.getElementById('loading').classList.add('show'); }
        function hideLoading() { document.getElementById('loading').classList.remove('show'); }
        function showError(message) {
            const el = document.getElementById('errorMessage');
            el.textContent = '❌ ' + message;
            el.classList.add('show');
        }
        function hideError() { document.getElementById('errorMessage').classList.remove('show'); }
        function showDetail() { document.getElementById('customerDetail').classList.add('show'); }
        function hideDetail() { document.getElementById('customerDetail').classList.remove('show'); }

        // Enter 키로 검색
        document.getElementById('customerName').addEventListener('keypress', (e) => {
            if (e.key === 'Enter') searchCustomer();
        });
        document.getElementById('customerPhone').addEventListener('keypress', (e) => {
            if (e.key === 'Enter') searchCustomer();
        });

        let isLoggedIn = true;  // 초기 상태 = 로그인됨

        // 로그아웃 OR 로그인 메뉴 오픈
        function logoutOrOpenMenu() {
            if (isLoggedIn) {
                // 로그아웃 실행
                logout();
            } else {
                // 로그인 드롭다운 열기
                toggleDropdown();
            }
        }

        // 로그아웃 기능
        function logout() {
            isLoggedIn = false;

            // 이름 숨기기
            document.getElementById('userName').style.display = 'none';

            // 버튼을 "로그인 ⌵"으로 변경
            const btn = document.getElementById('authButton');
            btn.textContent = "로그인 ⌵";

            // 드롭다운 닫기
            document.getElementById('loginDropdown').style.display = 'none';
        }

        // 로그인 메뉴 열기/닫기
        function toggleDropdown() {
            const menu = document.getElementById('loginDropdown');
            menu.style.display = (menu.style.display === "flex") ? "none" : "flex";
        }

        // 홍길동 로그인
        function loginAsUser() {
            isLoggedIn = true;

            // 이름 표시
            document.getElementById('userName').style.display = 'inline';

            // 버튼 텍스트 변경
            const btn = document.getElementById('authButton');
            btn.textContent = "로그아웃";

            // 드롭다운 닫기
            document.getElementById('loginDropdown').style.display = 'none';
        }

        // 관리자 페이지 이동
        function goAdminPage() {
            window.location.href = "/admin";   // 원하는 URL로 변경
        }

        // 바깥 클릭 시 드롭다운 닫기
        document.addEventListener('click', function(event) {
            const dropdown = document.getElementById('loginDropdown');
            const button = document.getElementById('authButton');

            if (!dropdown.contains(event.target) && event.target !== button) {
                dropdown.style.display = "none";
            }
        });

            // 5~15초 사이 랜덤 시간마다 새로운 대기 고객 추가
            function scheduleNextIncomingCall() {
                const delay = (5 + Math.random() * 10) * 1000;

                incomingCallTimer = setTimeout(() => {

                    // 이석 상태일 때 → 신규 콜 생성 중단
                    if (agentStatus === 'away') return;

                    if (callQueue.length < 8) {
                        const newNumber = getRandomContactNumber();
                        if (newNumber && !callQueue.includes(newNumber)) {
                            callQueue.push(newNumber);
                        }
                        showCallRequestToast();
                    }

                    scheduleNextIncomingCall();
                }, delay);
            }




        // =============================
        // 콜 요청 토스트 (전화 요청중)
        // =============================
        function showCallRequestToast() {
            const container = document.getElementById('toastContainer');
            if (!container) return;

            // 대기 고객이 없으면 아무것도 표시하지 않음
            if (callQueue.length === 0) {
                container.innerHTML = '';
                return;
            }

            // 기존 토스트 제거
            container.innerHTML = '';

            const toast = document.createElement('div');
            toast.className = 'toast call-request';

            // 🔁 여기서부터 내용만 단순 문구로 변경
            toast.innerHTML = `
        <div class="toast-icon">📞</div>
        <div class="toast-content">
            <h4>대기 중인 고객이 있습니다.</h4>
            <p>콜을 받아 상담을 시작해 주세요.</p>
        </div>
        <button class="toast-close" onclick="hideCallRequestToast()">✕</button>
    `;

            container.appendChild(toast);

            setTimeout(() => {
                toast.classList.add('show');
            }, 10);
        }




        function hideCallRequestToast() {
            const container = document.getElementById('toastContainer');
            if (!container) return;
            container.innerHTML = '';
        }

        // 페이지 로드 시 자동으로 "전화 요청중" 토스트 띄우기
            document.addEventListener('DOMContentLoaded', async () => {
            await loadContactPool();       // 🟡 contactPool 백엔드에서 받아오기
            showCallRequestToast();
            scheduleNextIncomingCall();  // 🟡 랜덤으로 대기 고객 계속 늘어나게

            // 통화 관련 버튼 누르면 토스트 닫기
            const ids = ['btnReady', 'btnAway', 'btnHold', 'btnDial', 'answerCallBtn'];
            ids.forEach(id => {
                const btn = document.getElementById(id);
                if (btn) {
                    btn.addEventListener('click', hideCallRequestToast);
                }
            });
        });

        //  약정 한글로 변환
        function formatContract(contract) {
            switch (contract) {
                case 'Month-to-month':
                    return '무약정';
                case 'One year':
                    return '1년';
                case 'Two year':
                    return '2년';
                default:
                    return contract || '-';
            }
        }

        //  고객ID에서 하이픈(-) 제거
        function formatCustomerId(id) {
            if (!id) return '';
            return String(id).replace(/-/g, '');
        }

        //  달러 → 원화 변환 (예: $76.45 → 114,000원)
        function formatCurrencyKRW(usd) {
            if (usd === null || usd === undefined || usd === '') return '-';
            const rate = 1470;  //  환율
            const num = parseFloat(usd);
            if (isNaN(num)) return '-';
            const krw = Math.round(num * rate);
            return krw.toLocaleString('ko-KR') + '원';
        }

        //  인터넷 서비스 한글 변환
        function translateInternetService(service) {
            switch (service) {
                case 'Fiber optic':
                    return '광 케이블';
                case 'DSL':
                    return 'DSL';
                case 'No':
                    return '안함';
                default:
                    return service || '-';
            }
        }

        // 결제방식 한글 변환
        function translatePaymentMethod(method) {
            switch (method) {
                case 'Electronic check':
                    return '계좌이체';
                case 'Credit card (automatic)':
                    return '신용카드';
                case 'Mailed check':
                    return '지로';
                default:
                    return method || '-';
            }
        }

        async function loadContactPool() {
            const res = await fetch(`${API_BASE}/contact_numbers`);
            const data = await res.json();
            contactPool = data.contact_numbers || [];
        }



    </script>
