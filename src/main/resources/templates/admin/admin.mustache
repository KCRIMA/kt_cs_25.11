    // Update KPI cards
    function updateKPIs() {
        const totalCustomers = customerData.length;
        const riskCustomers = customerData.filter(c => c.Churn_Probability >= 0.7).length;
        const avgWaitTime = Math.round(customerData.reduce((sum, c) => sum + c.wait_time_sec, 0) / totalCustomers);
        const repeatRate = ((customerData.filter(c => c.repeat_contacts_7d > 0).length / totalCustomers) * 100).toFixed(1);

        document.getElementById('totalCustomers').textContent = totalCustomers.toLocaleString();
        document.getElementById('riskCustomers').textContent = riskCustomers;
        document.getElementById('avgWaitTime').textContent = avgWaitTime + '초';
        document.getElementById('repeatRate').textContent = repeatRate + '%';
    }

