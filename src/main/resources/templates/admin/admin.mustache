                    },
                    y: {
                        grid: { color: 'rgba(51, 65, 85, 0.5)' },
                        ticks: { color: '#64748b', font: { size: 11 } }
                    }
                }
            }
        });
    }

    // Scatter Chart (Repeat Contacts vs Churn Probability)
    function renderScatterChart() {
        const ctx = document.getElementById('scatterChart').getContext('2d');
        
        const scatterData = customerData.map(c => ({
            x: c.repeat_contacts_7d,
            y: c.Churn_Probability,
            category: c.issue_category
        }));

        const categoryColors = {
            '요금': 'rgba(59, 130, 246, 0.7)',
            '품질': 'rgba(139, 92, 246, 0.7)',
            '해지': 'rgba(239, 68, 68, 0.7)',
            '장애': 'rgba(245, 158, 11, 0.7)',
            '해당 없음': 'rgba(107, 114, 128, 0.7)'
        };

        const datasets = Object.keys(categoryColors).map(category => ({
            label: category,
            data: scatterData.filter(d => d.category === category).map(d => ({ x: d.x, y: d.y })),
            backgroundColor: categoryColors[category],
            borderColor: categoryColors[category].replace('0.7', '1'),
            borderWidth: 1,
            pointRadius: 6,
            pointHoverRadius: 8
        }));

        new Chart(ctx, {
            type: 'scatter',
            data: { datasets },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'top',
                        labels: {
                            color: '#94a3b8',
                            font: { size: 11 },
                            usePointStyle: true,
                            padding: 12
                        }
                    },
                    tooltip: {
                        backgroundColor: '#1e293b',
                        titleColor: '#f8fafc',
                        bodyColor: '#94a3b8',
                        borderColor: '#334155',
                        borderWidth: 1,
                        cornerRadius: 8,
                        callbacks: {
                            label: function(context) {
                                return `반복문의: ${context.parsed.x}회, 이탈확률: ${(context.parsed.y * 100).toFixed(1)}%`;
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        title: {
                            display: true,
                            text: '7일 내 반복 문의 횟수',
                            color: '#94a3b8'
                        },
                        grid: { color: 'rgba(51, 65, 85, 0.5)' },
                        ticks: { color: '#64748b' }
                    },
                    y: {
                        title: {
                            display: true,
                            text: '이탈 확률',
                            color: '#94a3b8'
                        },
                        grid: { color: 'rgba(51, 65, 85, 0.5)' },
                        ticks: { 
                            color: '#64748b',
                            callback: function(value) {
                                return (value * 100) + '%';
                            }
                        },
                        min: 0,
                        max: 1
                    }
                }
            }
        });
    }

    // Contract Type Bar Chart
    function renderContractChart() {
        const ctx = document.getElementById('contractChart').getContext('2d');
        
        const contractData = {};
        const contractChurn = {};
        
        customerData.forEach(c => {
            contractData[c.Contract] = (contractData[c.Contract] || 0) + 1;
            if (c.Churn_Probability >= 0.5) {
                contractChurn[c.Contract] = (contractChurn[c.Contract] || 0) + 1;
            }
        });

        const labels = Object.keys(contractData);
        const churnRates = labels.map(label => 
            ((contractChurn[label] || 0) / contractData[label] * 100).toFixed(1)
        );

        const gradient = ctx.createLinearGradient(0, 280, 0, 0);
        gradient.addColorStop(0, 'rgba(99, 102, 241, 0.2)');
        gradient.addColorStop(1, 'rgba(99, 102, 241, 0.8)');

        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labels.map(l => {
                    if (l === 'Month-to-month') return '월별 계약';
                    if (l === 'One year') return '1년 계약';
                    if (l === 'Two year') return '2년 계약';
                    return l;
                }),
                datasets: [{
                    label: '이탈률 (%)',
                    data: churnRates,
                    backgroundColor: [
                        'rgba(239, 68, 68, 0.7)',
                        'rgba(245, 158, 11, 0.7)',
                        'rgba(16, 185, 129, 0.7)'
                    ],
                    borderColor: [
                        'rgba(239, 68, 68, 1)',
                        'rgba(245, 158, 11, 1)',
                        'rgba(16, 185, 129, 1)'
                    ],
                    borderWidth: 2,
                    borderRadius: 8,
                    barThickness: 60
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#1e293b',
                        titleColor: '#f8fafc',
                        bodyColor: '#94a3b8',
                        borderColor: '#334155',
                        borderWidth: 1,
                        cornerRadius: 8,
                        callbacks: {
                            label: function(context) {
                                return `이탈률: ${context.raw}%`;
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        grid: { display: false },
                        ticks: { color: '#94a3b8', font: { size: 12 } }
                    },
                    y: {
                        grid: { color: 'rgba(51, 65, 85, 0.5)' },
                        ticks: { 
                            color: '#64748b',
                            callback: function(value) {
                                return value + '%';
                            }
                        },
                        max: 100
                    }
                }
            }
        });
    }

    // Wait Time Distribution Chart
    function renderWaitTimeChart() {
        const ctx = document.getElementById('waitTimeChart').getContext('2d');
        
        // Create bins for wait time (0-30, 30-60, 60-90, 90-120, 120-150, 150-180, 180+)
        const bins = [0, 0, 0, 0, 0, 0, 0];
        const binLabels = ['0-30초', '30-60초', '60-90초', '90-120초', '120-150초', '150-180초', '180초+'];
        
        customerData.forEach(c => {
            const waitTime = c.wait_time_sec;
            if (waitTime < 30) bins[0]++;
            else if (waitTime < 60) bins[1]++;
            else if (waitTime < 90) bins[2]++;
            else if (waitTime < 120) bins[3]++;
            else if (waitTime < 150) bins[4]++;
            else if (waitTime < 180) bins[5]++;
            else bins[6]++;
        });

        const gradient = ctx.createLinearGradient(0, 0, 0, 200);
        gradient.addColorStop(0, 'rgba(20, 184, 166, 0.8)');
        gradient.addColorStop(1, 'rgba(20, 184, 166, 0.2)');

        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: binLabels,
                datasets: [{
                    label: '고객 수',
                    data: bins,
                    backgroundColor: gradient,
                    borderColor: 'rgba(20, 184, 166, 1)',
                    borderWidth: 1,
                    borderRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#1e293b',
                        titleColor: '#f8fafc',
                        bodyColor: '#94a3b8',
                        borderColor: '#334155',
                        borderWidth: 1,
                        cornerRadius: 8
                    }
                },
                scales: {
                    x: {
                        grid: { display: false },
                        ticks: { color: '#64748b', font: { size: 9 } }
                    },
                    y: {
                        grid: { color: 'rgba(51, 65, 85, 0.5)' },
                        ticks: { color: '#64748b', font: { size: 10 } }
                    }
                }
            }
        });
    }

    // Call Duration Distribution Chart
    function renderCallDurationChart() {
        const ctx = document.getElementById('callDurationChart').getContext('2d');
        
        // Create bins for call duration (0-2분, 2-5분, 5-10분, 10-15분, 15-20분, 20분+)
        const bins = [0, 0, 0, 0, 0, 0];
        const binLabels = ['0-2분', '2-5분', '5-10분', '10-15분', '15-20분', '20분+'];
        
        customerData.forEach(c => {
            const duration = c.call_duration_sec / 60; // Convert to minutes
            if (duration < 2) bins[0]++;
            else if (duration < 5) bins[1]++;
            else if (duration < 10) bins[2]++;
            else if (duration < 15) bins[3]++;
            else if (duration < 20) bins[4]++;
            else bins[5]++;
        });

        const gradient = ctx.createLinearGradient(0, 0, 0, 200);
        gradient.addColorStop(0, 'rgba(99, 102, 241, 0.8)');
        gradient.addColorStop(1, 'rgba(99, 102, 241, 0.2)');

        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: binLabels,
                datasets: [{
                    label: '고객 수',
                    data: bins,
                    backgroundColor: gradient,
                    borderColor: 'rgba(99, 102, 241, 1)',
                    borderWidth: 1,
                    borderRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#1e293b',
                        titleColor: '#f8fafc',
                        bodyColor: '#94a3b8',
                        borderColor: '#334155',
                        borderWidth: 1,
                        cornerRadius: 8
                    }
                },
                scales: {
                    x: {
                        grid: { display: false },
                        ticks: { color: '#64748b', font: { size: 10 } }
                    },
                    y: {
                        grid: { color: 'rgba(51, 65, 85, 0.5)' },
                        ticks: { color: '#64748b', font: { size: 10 } }
                    }
                }
            }
        });
    }

    // Render customer table
    function renderTable() {
        const tbody = document.getElementById('customerTableBody');
        const startIndex = (currentPage - 1) * itemsPerPage;
        const endIndex = startIndex + itemsPerPage;
        const pageData = filteredData.slice(startIndex, endIndex);

        tbody.innerHTML = pageData.map(customer => {
            const riskClass = customer.Churn_Probability >= 0.7 ? 'high' : 
                              customer.Churn_Probability >= 0.4 ? 'medium' : 'low';
            const riskLabel = riskClass === 'high' ? '고위험' : 
                              riskClass === 'medium' ? '중위험' : '저위험';
            
            const issueClass = customer.issue_category === '요금' ? 'billing' :
                               customer.issue_category === '품질' ? 'quality' :
                               customer.issue_category === '해지' ? 'churn' : 'fault';

            return `
                <tr onclick="viewCustomerDetail('${customer.customerID}')">
                    <td><span class="customer-id">${customer.customerID}</span></td>
                    <td><span class="customer-name">${customer.customer_name}</span></td>
                    <td>
                        <span class="risk-badge ${riskClass}">
                            ${(customer.Churn_Probability * 100).toFixed(1)}% ${riskLabel}
                        </span>
                    </td>
                    <td><span class="issue-badge ${issueClass}">${customer.issue_category}</span></td>
                    <td>
                        <span class="contact-count">
                            <span class="contact-dot"></span>
                            ${customer.repeat_contacts_7d}회
                        </span>
                    </td>
                    <td>${customer.wait_time_sec}초</td>
                    <td>${customer.Contract === 'Month-to-month' ? '월별' : 
                         customer.Contract === 'One year' ? '1년' : '2년'}</td>
                    <td>₩${customer.MonthlyCharges.toLocaleString()}</td>
                </tr>
            `;
        }).join('');

        updatePagination();
    }

    // Update pagination
    function updatePagination() {
        const totalPages = Math.ceil(filteredData.length / itemsPerPage);
        const startIndex = (currentPage - 1) * itemsPerPage + 1;
        const endIndex = Math.min(currentPage * itemsPerPage, filteredData.length);

        document.getElementById('paginationInfo').textContent = 
            `총 ${filteredData.length}건 중 ${startIndex} - ${endIndex} 표시`;

        const paginationButtons = document.getElementById('paginationButtons');
        let buttonsHTML = '';

        // Previous button
        buttonsHTML += `<button class="page-btn" onclick="changePage(${currentPage - 1})" ${currentPage === 1 ? 'disabled' : ''}>‹</button>`;

        // Page numbers
        for (let i = 1; i <= totalPages; i++) {
            if (i === 1 || i === totalPages || (i >= currentPage - 1 && i <= currentPage + 1)) {
                buttonsHTML += `<button class="page-btn ${i === currentPage ? 'active' : ''}" onclick="changePage(${i})">${i}</button>`;
            } else if (i === currentPage - 2 || i === currentPage + 2) {
                buttonsHTML += `<button class="page-btn" disabled>...</button>`;
            }
        }

        // Next button
        buttonsHTML += `<button class="page-btn" onclick="changePage(${currentPage + 1})" ${currentPage === totalPages ? 'disabled' : ''}>›</button>`;

        paginationButtons.innerHTML = buttonsHTML;
    }

    // Change page
    function changePage(page) {
        const totalPages = Math.ceil(filteredData.length / itemsPerPage);
        if (page >= 1 && page <= totalPages) {
            currentPage = page;
            renderTable();
        }
    }

    // Filter by risk level
    function filterRisk(level) {
        currentFilter = level;
        currentPage = 1;

        // Update filter button styles
        document.querySelectorAll('.filter-btn').forEach(btn => {
            btn.classList.remove('active');
        });
        event.target.classList.add('active');

        if (level === 'all') {
            filteredData = [...customerData];
        } else if (level === 'high') {
            filteredData = customerData.filter(c => c.Churn_Probability >= 0.7);
        } else if (level === 'medium') {
            filteredData = customerData.filter(c => c.Churn_Probability >= 0.4 && c.Churn_Probability < 0.7);
        } else {
            filteredData = customerData.filter(c => c.Churn_Probability < 0.4);
        }

        renderTable();
    }

    // Search customers
    function searchCustomers() {
        const searchTerm = document.getElementById('customerSearchInput').value.toLowerCase();
        currentPage = 1;

        if (searchTerm === '') {
            filterRisk(currentFilter);
            return;
        }

        filteredData = customerData.filter(c => 
            c.customerID.toLowerCase().includes(searchTerm) ||
            c.customer_name.toLowerCase().includes(searchTerm)
        );

        renderTable();
    }

    // View customer detail
    function viewCustomerDetail(customerId) {
        // Navigate to customer detail page or show modal
        console.log('View customer:', customerId);
        // window.location.href = `/customer/${customerId}`;
    }

    // Refresh data
    function refreshData() {
        location.reload();
    }

    // Initialize
    document.addEventListener('DOMContentLoaded', () => {
        // 먼저 API 연동 시도, 실패 시 샘플 데이터 사용
        loadData();
    });
</script>
