            '해당 없음': 'rgba(107, 114, 128, 0.7)'
        };

        const datasets = Object.keys(categoryColors).map(category => ({
            label: category,
            data: scatterData.filter(d => d.issue_category === category).map(d => ({ x: d.repeat_contacts_7d, y: d.Churn_Probability })),
            backgroundColor: categoryColors[category],
            borderColor: categoryColors[category].replace('0.7', '1'),
            borderWidth: 1,
            pointRadius: 4,
            pointHoverRadius: 6
        }));

        new Chart(ctx, {
            type: 'scatter',
            data: { datasets },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'top', labels: { color: '#94a3b8', font: { size: 10 }, usePointStyle: true, padding: 8 } },
                    tooltip: {
                        backgroundColor: '#1e293b', titleColor: '#f8fafc', bodyColor: '#94a3b8', borderColor: '#334155', borderWidth: 1, cornerRadius: 8,
