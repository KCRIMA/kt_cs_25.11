    // Fetch and process CSV data
    async function loadData() {
        try {
            // 1. 테이블용 고객 데이터 로드 (페이지네이션용)
            const customersResponse = await fetch(`${API_BASE_URL}/admin/customers?limit=1500`);
            if (!customersResponse.ok) throw new Error('Failed to fetch customers');
            const customersData = await customersResponse.json();
            customerData = customersData.customers;
            
            // Sort by churn probability descending
            customerData.sort((a, b) => b.Churn_Probability - a.Churn_Probability);
            filteredData = [...customerData];
            
            // 2. KPI 통계 로드 (전체 데이터 기반 - 서버에서 계산)
            const statsResponse = await fetch(`${API_BASE_URL}/admin/stats`);
            if (statsResponse.ok) {
                const stats = await statsResponse.json();
                document.getElementById('totalCustomers').textContent = stats.total_customers.toLocaleString();
                document.getElementById('riskCustomers').textContent = stats.risk_customers;
                document.getElementById('avgWaitTime').textContent = stats.avg_wait_time + '초';
                document.getElementById('repeatRate').textContent = stats.repeat_rate + '%';
            }
            
            // 3. 차트 데이터 로드 (전체 데이터 기반 - 서버에서 계산)
            const chartsResponse = await fetch(`${API_BASE_URL}/admin/charts`);
            if (chartsResponse.ok) {
                chartDataFromAPI = await chartsResponse.json();
                renderChartsFromAPI(chartDataFromAPI);
            } else {
                // API 실패 시 클라이언트 데이터로 렌더링
                renderCharts();
            }
            
            renderTable();
            
            console.log('✅ API 데이터 로드 완료 - 테이블:', customerData.length, '건, 차트: 전체 데이터 기반');
        } catch (error) {
            console.error('❌ API 로드 실패, 샘플 데이터 사용:', error);
