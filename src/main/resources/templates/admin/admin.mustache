    function renderScatterChartFromAPI(scatterData) {
        const ctx = document.getElementById('scatterChart').getContext('2d');
        
        const categoryColors = {
            '요금': 'rgba(59, 130, 246, 0.7)',
            '품질': 'rgba(139, 92, 246, 0.7)',
